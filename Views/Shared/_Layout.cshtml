            box-shadow: 0 6px 18px rgba(0,0,0,.25);
        ">
        🔊
    </button>

    <!-- ========================= -->
    <!-- BOTÓN DETENER -->
    <!-- ========================= -->
    <button onclick="detenerLectura()"
            title="Detener lectura"
            aria-label="Detener lectura"
            style="
            position: fixed;
            bottom: 20px;
            right: 84px;
            z-index: 9999;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            border: none;
            background: #ef4444;
