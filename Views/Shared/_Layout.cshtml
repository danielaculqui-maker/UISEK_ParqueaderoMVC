            cursor: pointer;
            box-shadow: 0 6px 18px rgba(0,0,0,.25);
        ">
        ⏹️
    </button>

    <!-- ========================= -->
    <!-- SCRIPT DE AUDIO -->
    <!-- ========================= -->
    <script>
        let voces = [];
        let vozES = null;

        
        function cargarVoces() {
            voces = speechSynthesis.getVoices() || [];
            vozES =
                voces.find(v => (v.lang || "").toLowerCase().startsWith("es")) ||
                voces[0] || null;

            console.log("Voces:", voces.map(v => `${v.name} (${v.lang})`));
            console.log("Voz usada:", vozES ? vozES.name : "NINGUNA");
        }

        cargarVoces();
        speechSynthesis.onvoiceschanged = cargarVoces;

        /*  Leer pantalla */
        function leerPagina() {

            // Lee solo <main> si existe, si no todo
            const cont = document.querySelector("main") || document.body;
            let texto = (cont.innerText || "").trim();

            if (!texto) {
                texto = "Pantalla del sistema UISEK.";
            }

            // Parar cualquier audio previo
            speechSynthesis.cancel();

            const u = new SpeechSynthesisUtterance(texto);
            u.lang = "es-ES";
            if (vozES) u.voice = vozES;
            u.rate = 1;
            u.pitch = 1;

            u.onstart = () => console.log("🔊 Lectura iniciada");
            u.onend = () => console.log("✅ Lectura finalizada");
            u.onerror = e => console.log("❌ Error TTS", e);

            speechSynthesis.speak(u);
        }

        /*  Detener lectura */
        function detenerLectura() {
            speechSynthesis.cancel();
            console.log("⏹️ Lectura detenida");
        }

        /*  Accesos rápidos */
        document.addEventListener("keydown", function (e) {
            if (e.key.toLowerCase() === "l") {
                leerPagina();          // L = Leer
            }
            if (e.key === "Escape") {
                detenerLectura();      // ESC = Detener
            }
        });

        /*  Detener al cambiar de página */
        window.addEventListener("beforeunload", function () {
            speechSynthesis.cancel();
        });
    </script>


</body>
</html>
