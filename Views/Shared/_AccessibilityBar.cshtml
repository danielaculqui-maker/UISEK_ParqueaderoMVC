@{
    var dislexia = (Session["ModoDislexia"] as bool?) ?? false;
    var oscuro = (Session["ModoOscuro"] as bool?) ?? false;
    var contraste = (Session["AltoContraste"] as bool?) ?? false;
}

<div class="acc-mini">
    <button type="button"
            class="acc-btn @(dislexia ? "on" : "")"
            onclick="togglePref('ToggleDislexia')"
            aria-pressed="@(dislexia ? "true" : "false")"
            title="Modo Dislexia">
        📖
    </button>

    <button type="button"
            class="acc-btn @(oscuro ? "on" : "")"
            onclick="togglePref('ToggleOscuro')"
            aria-pressed="@(oscuro ? "true" : "false")"
            title="Modo Oscuro">
        🌙
    </button>

    <button type="button"
            class="acc-btn @(contraste ? "on" : "")"
            onclick="togglePref('ToggleAltoContraste')"
            aria-pressed="@(contraste ? "true" : "false")"
            title="Alto Contraste">
        🌓
    </button>
</div>

<script>
   function togglePref(actionName) {
    const urlMap = {
      "ToggleDislexia": "@Url.Action("ToggleDislexia","Accesibilidad")",
      "ToggleOscuro": "@Url.Action("ToggleOscuro","Accesibilidad")",
      "ToggleAltoContraste": "@Url.Action("ToggleAltoContraste","Accesibilidad")"
    };

    fetch(urlMap[actionName], {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" }
    }).then(() => location.reload());
  }
</script>
