@{@model List<UISEK_ParqueaderoMVC.Models.UsuarioRow>
@{
    ViewBag.Title = "Usuarios";
}

<div class="card">
    <h2>👥 Usuarios del sistema</h2>
    <p class="muted">Mostrando @Model.Count usuario(s) registrados.</p>

    <table style="width:100%; border-collapse:collapse; margin-top:12px;">
        <thead>
            <tr style="text-align:left; border-bottom:1px solid #e6e6e6;">
                <th style="padding:10px;">ID</th>
                <th style="padding:10px;">Correo</th>
                <th style="padding:10px;">Rol</th>
                <th style="padding:10px;">Discapacidad</th>
                <th style="padding:10px;">Vehículos</th>
                <th style="padding:10px;">Activo</th>
                <th style="padding:10px;">Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr style="border-bottom:1px solid #f0f0f0;">
                    <td style="padding:10px;">@u.UsuarioId</td>
                    <td style="padding:10px;">@u.Correo</td>
                    <td style="padding:10px;">@u.Rol</td>
                    <td style="padding:10px;">@(u.TieneDiscapacidad ? "Sí" : "No")</td>
                    <td style="padding:10px;">@u.Vehiculos</td>
                    <td style="padding:10px;">@(u.Activo ? "Sí" : "No")</td>
                    <td style="padding:10px;">@u.FechaRegistro</td>
                </tr>
            }
        </tbody>
    </table>
</div>
