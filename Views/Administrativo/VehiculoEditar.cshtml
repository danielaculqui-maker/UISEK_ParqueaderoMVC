@model UISEK_ParqueaderoMVC.Models.VehiculoAdminDetallesVM
@{
    ViewBag.Title = "Vehículo - Editar";
}

<style>
    .fondo-uisek {
        background: linear-gradient(rgba(255,255,255,.92), rgba(255,255,255,.92)), url('/Content/Imagenes/fondo_uisek.png');
        background-size: cover;
        min-height: 100vh;
        padding: 24px;
        border-radius: 18px;
    }

    body.oscuro .fondo-uisek {
        background: linear-gradient(rgba(15,23,42,.92), rgba(15,23,42,.92)), url('/Content/Imagenes/fondo_uisek.png');
    }

    body.contraste .fondo-uisek {
        background: #000;
    }

    .card {
        background: #ffffff;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
        max-width: 720px;
    }

    body.oscuro .card {
        background: #020617;
        color: #e5e7eb;
    }

    body.contraste .card {
        background: #000;
        color: #fff;
        border: 2px solid #fff;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    label {
        font-weight: 900;
        font-size: 13px;
        opacity: .9;
    }

    input, select {
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        font-weight: 700;
        outline: none;
    }

    body.oscuro input, body.oscuro select {
        background: #0b1220;
        color: #e5e7eb;
        border: 1px solid #1e293b;
    }

    body.contraste input, body.contraste select {
        background: #000;
        color: #fff;
        border: 2px solid #fff;
    }

    .pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        background: #eef2ff;
        font-weight: 800;
        font-size: 12px;
        margin-left: 8px;
    }

    body.oscuro .pill {
        background: #1e293b;
        color: #e5e7eb;
    }

    body.contraste .pill {
        background: #fff;
        color: #000;
    }

    .acciones {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .btn {
        padding: 8px 12px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 900;
        border: none;
        cursor: pointer;
        display: inline-flex;
        gap: 6px;
        align-items: center;
        transition: .2s;
    }

        .btn:hover {
            transform: scale(1.03);
        }

    .btn-guardar {
        background: #dcfce7;
        color: #0f172a;
    }

    .btn-volver {
        background: #eef2ff;
        color: #0f172a;
    }

    body.oscuro .btn-guardar {
        background: #12331f;
        color: #e5e7eb;
    }

    body.oscuro .btn-volver {
        background: #1e293b;
        color: #e5e7eb;
    }

    body.contraste .btn {
        background: #fff;
        color: #000;
        border: 2px solid #000;
    }
</style>

<div class="fondo-uisek">
    <h2 style="margin-bottom:16px;">✏️ Editar Vehículo <span class="pill">@Model.Origen</span></h2>

    <div class="card">

        @using (Html.BeginForm("VehiculoEditar", "Administrativo", FormMethod.Post))

        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="Origen" value="@Model.Origen" />





            <div class="grid">
                <div class="field">
                    <label>Placa</label>
                    @Html.TextBoxFor(m => m.Placa, new { @placeholder = "ABC123", @required = "required" })
                </div>

                <div class="field">
                    <label>Tipo</label>
                    @Html.TextBoxFor(m => m.Tipo, new { @placeholder = "AUTO / MOTO", @required = "required" })
                </div>

                <div class="field" style="grid-column: 1 / -1;">
                    <label>Marca / Modelo</label>
                    @Html.TextBoxFor(m => m.MarcaModelo, new { @placeholder = "Chevrolet Sail, etc." })
                </div>

                <div class="field" style="grid-column: 1 / -1;">
                    <label>Activo</label>
                    <select name="Activo">
                        <option value="true" @(Model.Activo ? "selected" : "")>Sí (Activo)</option>
                        <option value="false" @(!Model.Activo ? "selected" : "")>No (Inactivo)</option>
                    </select>
                </div>
            </div>

            <div class="acciones">
                <button type="submit" class="btn btn-guardar">💾 Guardar</button>
                <a class="btn btn-volver" href="@Url.Action("Vehiculos","Administrativo")">⬅ Cancelar</a>
            </div>
        }

    </div>
</div>
