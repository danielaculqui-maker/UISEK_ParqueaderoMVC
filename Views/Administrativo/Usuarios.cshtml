@model List<UISEK_ParqueaderoMVC.Models.AdminUsuarioListVM>
@{
    ViewBag.Title = "Gestionar Personas";
}

<style>
   
    .fondo-uisek {
        background: linear-gradient(rgba(255,255,255,.92), rgba(255,255,255,.92)), url('/Content/Imagenes/fondo_uisek.png');
        background-size: cover;
        min-height: 100vh;
        padding: 24px;
        border-radius: 18px;
    }

    .card {
        background: #ffffff;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: 14px;
    }

    th {
        background: #0f172a;
        color: white;
        padding: 12px;
        text-align: left;
        font-size: 14px;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
        vertical-align: middle;
    }

    tr:hover {
        background: #f8fafc;
    }

    .acciones {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn {
        padding: 6px 10px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
        border: none;
        cursor: pointer;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .btn-detalle {
        background: #e0f2fe;
    }

    .btn-editar {
        background: #fef9c3;
    }

    .btn-eliminar {
        background: #fee2e2;
    }

    .estado-ok {
        color: #16a34a;
        font-weight: 900;
    }

    .estado-off {
        color: #dc2626;
        font-weight: 900;
    }

    .pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        background: #eef2ff;
        font-weight: 800;
        font-size: 12px;
        margin-left: 8px;
    }

    /* ======================================
   ✅ MODO OSCURO - USUARIOS (COMPLETO)
   PÉGALO AL FINAL DEL <style>
   ====================================== */

    body.oscuro .fondo-uisek {
        background: linear-gradient(rgba(15,23,42,.92), rgba(15,23,42,.92)), url('/Content/Imagenes/fondo_uisek.png') !important;
    }

    body.oscuro .card {
        background: #020617 !important;
        color: #e5e7eb !important;
    }

    body.oscuro table {
        background: transparent !important;
    }

    body.oscuro th {
        background: #0b1220 !important;
        color: #ffffff !important;
    }

    body.oscuro td {
        color: #e5e7eb !important;
        border-bottom: 1px solid #1e293b !important;
    }

    body.oscuro tr:hover {
        background: #0b1220 !important;
    }

    /* Pills */
    body.oscuro .pill {
        background: #1e293b !important;
        color: #e5e7eb !important;
    }

    /* Botones acciones */
    body.oscuro .btn-detalle {
        background: #1e293b !important;
        color: #e5e7eb !important;
    }

    body.oscuro .btn-editar {
        background: #3b2f0b !important;
        color: #e5e7eb !important;
    }

    body.oscuro .btn-eliminar {
        background: #3b0b0b !important;
        color: #e5e7eb !important;
    }

    /* Estados */
    body.oscuro .estado-ok {
        color: #22c55e !important;
    }

    body.oscuro .estado-off {
        color: #ef4444 !important;
    }

</style>

<div class="fondo-uisek">

    <h2 style="margin-bottom:16px;">👥 Gestionar Personas</h2>

    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <b>@u.Nombre</b>
                            <span class="pill">@u.Tipo</span>
                        </td>
                        <td>@u.Correo</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="estado-ok">● Activo</span>
                            }
                            else
                            {
                                <span class="estado-off">● Inactivo</span>
                            }
                        </td>
                        <td>
                            <div class="acciones">
                                <!-- ✅ DETALLES: mandar id + tipo -->
                                <a class="btn btn-detalle"
                                   href="@Url.Action("UsuarioDetalles","Administrativo", new { id = u.Id, tipo = u.Tipo })"
                                   title="Ver detalles">👁</a>

                                <!-- ✅ EDITAR: mandar id + tipo -->
                                <a class="btn btn-editar"
                                   href="@Url.Action("UsuarioEditar","Administrativo", new { id = u.Id, tipo = u.Tipo })"
                                   title="Editar">✏️</a>

                                <!-- ✅ ELIMINAR/DESACTIVAR: POST + AntiForgery -->
                                @using (Html.BeginForm("UsuarioEliminar", "Administrativo", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="tipo" value="@u.Tipo" />
                                    <button type="submit"
                                            class="btn btn-eliminar"
                                            onclick="return confirm('¿Desactivar esta persona?');"
                                            title="Desactivar">
                                        🗑
                                    </button>
                                }

                            </div>

                        </td>
                    </tr>

                }
            </tbody>

        </table>
        <div style="margin-top:14px;">
            <a class="btn btn-detalle" href="@Url.Action("Index","Administrativo")">⬅ Volver al panel</a>
        </div>
    </div>

</div>
