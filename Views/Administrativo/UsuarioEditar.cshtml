@model UISEK_ParqueaderoMVC.Models.AdminUsuarioDetallesVM
@{
    ViewBag.Title = "Editar Usuario";
}

<style>
    /* ===============================
   FIX CONTRASTE MODO OSCURO
   =============================== */

    body.oscuro td,
    body.oscuro th,
    body.oscuro .lbl,
    body.oscuro .val {
        color: #e5e7eb !important; /* gris claro legible */
    }

    .fondo-uisek {
        background: linear-gradient(rgba(255,255,255,.92), rgba(255,255,255,.92)), url('/Content/Imagenes/fondo_uisek.png');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        padding: 24px;
        border-radius: 18px;
    }

    body.oscuro .fondo-uisek {
        background: linear-gradient(rgba(15,23,42,.92), rgba(15,23,42,.92)), url('/Content/Imagenes/fondo_uisek.png');
    }

    body.contraste .fondo-uisek {
        background: #000;
    }

    .card {
        background: #fff;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 10px 25px rgba(0,0,0,.10);
        max-width: 900px;
    }

    body.oscuro .card {
        background: #020617;
        color: #e5e7eb;
    }

    body.contraste .card {
        background: #000;
        color: #fff;
        border: 2px solid #fff;
    }

    .title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }

        .title h2 {
            margin: 0;
            font-size: 22px;
            color: #0f172a;
        }

    body.oscuro .title h2, body.contraste .title h2 {
        color: #fff;
    }

    .pill {
        padding: 4px 12px;
        border-radius: 999px;
        background: #eef2ff;
        font-weight: 900;
        font-size: 12px;
    }

    body.oscuro .pill {
        background: #1e293b;
        color: #e5e7eb;
    }

    body.contraste .pill {
        background: #fff;
        color: #000;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 14px;
    }

    .field {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 12px;
    }

    body.oscuro .field {
        background: #020617;
        border-color: #1e293b;
    }

    body.contraste .field {
        background: #000;
        border: 2px solid #fff;
    }

    label {
        display: block;
        font-size: 12px;
        font-weight: 900;
        color: #64748b;
        margin-bottom: 6px;
    }

    body.oscuro label {
        color: #94a3b8;
    }

    body.contraste label {
        color: #fff;
    }

    input[type="text"], input[type="email"] {
        width: 100%;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        outline: none;
        font-weight: 700;
        background: #fff;
        color: #0f172a;
    }

    body.oscuro input[type="text"], body.oscuro input[type="email"] {
        background: #0b1220;
        border-color: #1e293b;
        color: #e5e7eb;
    }

    body.contraste input[type="text"], body.contraste input[type="email"] {
        background: #000;
        border: 2px solid #fff;
        color: #fff;
    }

    .row {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 16px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 10px 14px;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save {
        background: #dcfce7;
        color: #0f172a;
    }

    .btn-back {
        background: #e0f2fe;
        color: #0f172a;
    }

    body.oscuro .btn-save {
        background: #14532d;
        color: #e5e7eb;
    }

    body.oscuro .btn-back {
        background: #1e293b;
        color: #e5e7eb;
    }

    body.contraste .btn {
        background: #fff;
        color: #000;
    }

    .chk {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        padding: 10px 12px;
        border-radius: 12px;
        background: #f1f5f9;
        border: 1px solid #e5e7eb;
    }

    body.oscuro .chk {
        background: #0b1220;
        border-color: #1e293b;
    }

    body.contraste .chk {
        background: #000;
        border: 2px solid #fff;
    }
</style>

<div class="fondo-uisek">
    <div class="card">

        <div class="title">
            <span>✏️</span>
            <h2>Editar</h2>
            <span class="pill">@Model.Tipo</span>
        </div>

        @using (Html.BeginForm("UsuarioEditar", "Administrativo", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Tipo)

            <div class="grid">

                <div class="field">
                    <label>Nombre</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @type = "text", autocomplete = "off" })
                </div>

                <div class="field">
                    <label>Correo</label>
                    @Html.TextBoxFor(m => m.Correo, new { @type = "email", autocomplete = "off" })
                </div>

                <div class="field">
                    <label>Cédula</label>
                    @Html.TextBoxFor(m => m.Cedula, new { @type = "text", autocomplete = "off" })
                </div>

                <div class="field">
                    <label>Estado</label>
                    <div class="chk">
                        @Html.CheckBoxFor(m => m.Activo)
                        <span>Activo</span>
                    </div>
                </div>

            </div>

            @* Extras solo para visitante *@
            if ((Model.Tipo ?? "").ToUpper() == "VISITANTE")
            {
                <hr style="margin:18px 0;" />
                <h4>🚗 Datos del Vehículo</h4>

                <div class="grid">
                    <div class="field">
                        <label>Placa</label>
                        @Html.TextBoxFor(m => m.Placa, new { @type = "text", autocomplete = "off" })
                    </div>

                    <div class="field">
                        <label>Tipo Vehículo</label>
                        @Html.TextBoxFor(m => m.TipoVehiculo, new { @type = "text", autocomplete = "off" })
                    </div>

                    <div class="field">
                        <label>Marca / Modelo</label>
                        @Html.TextBoxFor(m => m.MarcaModelo, new { @type = "text", autocomplete = "off" })
                    </div>
                </div>
            }

            <div class="row">
                <button class="btn btn-save" type="submit">💾 Guardar</button>
                <a class="btn btn-back" href="@Url.Action("Usuarios","Administrativo")">⬅ Cancelar</a>
            </div>
        }

    </div>
</div>
