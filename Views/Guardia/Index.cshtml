@{
    ViewBag.Title = "Panel Guardia";
}

<style>
    /* (TODO TU CSS IGUAL, NO TOCADO) */
    .panel-wrap {
        min-height: calc(100vh - 78px);
        padding: 10px 6px;
    }

    .panel-surface {
        max-width: 980px;
        margin: 0 auto;
        padding: 18px;
        border-radius: 22px;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

        .panel-title h2 {
            margin: 0;
            font-weight: 900;
            color: var(--title);
        }

    .muted {
        color: #6c7a89;
        font-size: 13px;
    }

    .dash-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
        margin: 16px 0 18px 0;
    }

    .dash-card {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(0,0,0,.05);
        border-radius: 18px;
        padding: 14px 14px;
        display: flex;
        gap: 12px;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
    }

    .dash-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 20px;
        background: rgba(53,92,192,.10);
    }

    .dash-label {
        font-size: 12px;
        color: #6c7a89;
    }

    .dash-value {
        font-size: 16px;
        font-weight: 900;
        color: #1f2d3d;
        line-height: 1.1;
    }

    .bar-ok {
        border-left: 6px solid #2ecc71;
    }

    .bar-warn {
        border-left: 6px solid #f1c40f;
    }

    .bar-bad {
        border-left: 6px solid #e74c3c;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
        margin-top: 12px;
    }

    @@media (min-width: 900px) {
        .grid-2 {
            grid-template-columns: 1fr 1fr;
        }
    }

    .cardx {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(0,0,0,.05);
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
    }

        .cardx h3 {
            margin: 0 0 10px 0;
            font-weight: 900;
            color: #1f2d3d;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .table-wrap {
        overflow: auto;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,.06);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 620px;
        background: #fff;
    }

    th, td {
        padding: 10px 12px;
        font-size: 13px;
        border-bottom: 1px solid #eef1f4;
    }

    th {
        text-align: left;
        background: #f7f9fb;
        color: #2c3e50;
        font-weight: 900;
    }

    tr:hover td {
        background: #fbfdff;
    }

    .empty-state {
        text-align: center;
        padding: 22px 10px;
        color: #6c7a89;
    }

        .empty-state .big {
            font-size: 34px;
            margin-bottom: 8px;
        }

    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .btnx {
        border: 0;
        padding: 10px 14px;
        border-radius: 14px;
        font-weight: 900;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btnx-primary {
        background: #355CC0;
        color: #fff;
    }

        .btnx-primary:hover {
            opacity: .92;
        }

    .btnx-soft {
        background: #f3f5f7;
        color: #1f2d3d;
        border: 1px solid #e6eaee;
    }

        .btnx-soft:hover {
            background: #eceff2;
        }

    .badge-pill {
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #fff;
    }

    .badge-green {
        background: #2ecc71;
    }

    .badge-yellow {
        background: #f1c40f;
        color: #1f2d3d;
    }

    .msg-ok {
        background: #d4edda;
        color: #155724;
        padding: 10px 12px;
        border-radius: 12px;
        margin: 10px 0;
        font-weight: 800;
    }

    .msg-err {
        background: #f8d7da;
        color: #721c24;
        padding: 10px 12px;
        border-radius: 12px;
        margin: 10px 0;
        font-weight: 800;
    }

    .filter-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: end;
    }

        .filter-row label {
            display: block;
            font-weight: 900;
            color: #6c7a89;
            font-size: 12px;
            margin-bottom: 4px;
        }

    .inp, .sel {
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid #e6eaee;
        font-weight: 800;
        font-size: 13px;
        outline: none;
        background: #fff;
    }
    /* ============================
   FIX MODO OSCURO (GUARDIA)
   Pegar al FINAL del <style>
   ============================ */

    body.oscuro .panel-surface {
        background: transparent !important;
    }

    /* Cards (dash-card y cardx) más oscuras y legibles */
    body.oscuro .dash-card,
    body.oscuro .cardx,
    body.oscuro .filter-box,
    body.oscuro .table-wrap {
        background: rgba(17,24,39,.86) !important; /* antes estaba claro */
        border: 1px solid rgba(255,255,255,.10) !important;
        box-shadow: 0 10px 25px rgba(0,0,0,.45) !important;
        color: #e5e7eb !important;
    }

    /* Títulos y textos */
    body.oscuro h2,
    body.oscuro h3,
    body.oscuro .dash-value,
    body.oscuro .v {
        color: #f9fafb !important;
    }

    body.oscuro .muted,
    body.oscuro .dash-label,
    body.oscuro .k,
    body.oscuro .filter-row label {
        color: #9ca3af !important;
    }

    /* Inputs / selects */
    body.oscuro .inp,
    body.oscuro .sel {
        background: rgba(15,23,42,.85) !important;
        border: 1px solid rgba(255,255,255,.12) !important;
        color: #f9fafb !important;
    }

    /* Botones */
    body.oscuro .btnx-soft {
        background: rgba(15,23,42,.65) !important;
        border: 1px solid rgba(255,255,255,.14) !important;
        color: #f9fafb !important;
    }

        body.oscuro .btnx-soft:hover {
            background: rgba(255,255,255,.06) !important;
        }

    /* Tabla: esto es lo que más se nota en tu screenshot */
    body.oscuro table {
        background: rgba(17,24,39,.86) !important;
    }

    body.oscuro th {
        background: rgba(2,6,23,.70) !important;
        color: #f9fafb !important;
        border-bottom: 1px solid rgba(255,255,255,.10) !important;
    }

    body.oscuro td {
        color: #e5e7eb !important;
        border-bottom: 1px solid rgba(255,255,255,.06) !important;
    }

    body.oscuro tr:hover td {
        background: rgba(255,255,255,.04) !important;
    }

    /* Mensajes OK / ERR un poco más sobrios en oscuro */
    body.oscuro .msg-ok {
        background: rgba(34,197,94,.18) !important;
        color: #bbf7d0 !important;
    }

    body.oscuro .msg-err {
        background: rgba(239,68,68,.18) !important;
        color: #fecaca !important;
    }



</style>

@{
    bool scriptActivo = (ViewBag.ScriptActivo as bool?) ?? true;
    var cont = ViewBag.Contingencia as System.Collections.IEnumerable;

    // contar pendientes sin LINQ
    int pendientes = 0;
    if (cont != null)
    {
        foreach (var _ in cont) { pendientes++; }
    }

    string estadoSistemaTxt = scriptActivo ? "Activo" : "Contingencia";
    string barraSistema = scriptActivo ? "bar-ok" : "bar-bad";
    string iconoSistema = scriptActivo ? "🟢" : "🔴";

    string barraPend = (pendientes == 0) ? "bar-ok" : "bar-warn";
    string pendTxt = (pendientes == 0) ? "Sin pendientes" : (pendientes + " pendiente(s)");

    string badgeClass = scriptActivo ? "badge-green" : "badge-yellow";
    string badgeTxt = scriptActivo ? "Operación normal" : "Modo contingencia";
}

<div class="panel-wrap">
    <div class="panel-surface">

        <div class="panel-title">
            <span style="font-size:18px;">🛂</span>
            <div>
                <h2>Panel Guardia</h2>
                <div class="muted">Registro de accesos y plan de contingencia.</div>
            </div>
        </div>

        @if (TempData["MsgOk"] != null)
        {<div class="msg-ok">@TempData["MsgOk"]</div>}
        @if (TempData["Err"] != null)
        {<div class="msg-err">@TempData["Err"]</div>}

        <div class="dash-cards">
            <div class="dash-card @barraSistema">
                <div class="dash-icon">@iconoSistema</div>
                <div>
                    <div class="dash-label">Sistema</div>
                    <div class="dash-value">@estadoSistemaTxt</div>
                </div>
            </div>

            <div class="dash-card @barraPend">
                <div class="dash-icon">📌</div>
                <div>
                    <div class="dash-label">Contingencia</div>
                    <div class="dash-value">@pendTxt</div>
                </div>
            </div>

            <div class="dash-card bar-ok">
                <div class="dash-icon">🔐</div>
                <div>
                    <div class="dash-label">Rol</div>
                    <div class="dash-value">GUARDIA</div>
                </div>
            </div>

            <div class="dash-card bar-ok">
                <div class="dash-icon">🧾</div>
                <div>
                    <div class="dash-label">Fuente</div>
                    <div class="dash-value">@(scriptActivo ? "BD" : "Memoria")</div>
                </div>
            </div>
        </div>

        <div class="cardx">
            <h3>🧭 Estado actual</h3>
            <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0 12px 0;">
                <span class="badge-pill @badgeClass">@badgeTxt</span>
                <div class="muted">
                    @(scriptActivo
                        ? "Registra accesos normalmente. Si el sistema cae, usa contingencia."
                        : "Sistema caído: registra manualmente; luego consolida cuando vuelva.")
                </div>
            </div>
        </div>

        <div class="grid-2">
            <div class="cardx">
                <h3>✍️ Registrar acceso</h3>

                @if (scriptActivo)
                {
                    <div class="muted">Modo normal (guarda en BD).</div>

                    <form method="post" action="@Url.Action("Registrar","Guardia")" style="margin-top:10px;">
                        @Html.AntiForgeryToken()

                        <div class="filter-row">
                            <div>
                                <label>Placa</label>
                                <input class="inp" name="placa" placeholder="ABC1234" />
                            </div>

                            <div>
                                <label>Evento</label>
                                <select class="sel" name="evento">
                                    <option value="ENTRADA">ENTRADA</option>
                                    <option value="SALIDA">SALIDA</option>
                                </select>
                            </div>

                            <div>
                                <label>Zona (opcional)</label>
                                <input class="inp" name="zona" placeholder="Garita Sur" />
                            </div>

                            <button class="btnx btnx-primary" type="submit">✅ Registrar</button>
                        </div>

                        <div class="muted" style="margin-top:8px;">Solo placas registradas (UISEK).</div>
                    </form>
                }
                else
                {
                    <div class="muted">Modo contingencia (se guarda en memoria).</div>

                    <form method="post" action="@Url.Action("RegistrarContingencia","Guardia")" style="margin-top:10px;">
                        @Html.AntiForgeryToken()

                        <div class="filter-row">
                            <div>
                                <label>Placa</label>
                                <input class="inp" name="placa" placeholder="ABC1234" />
                            </div>

                            <div>
                                <label>Evento</label>
                                <select class="sel" name="evento">
                                    <option value="ENTRADA">ENTRADA</option>
                                    <option value="SALIDA">SALIDA</option>
                                </select>
                            </div>

                            <div>
                                <label>Zona (opcional)</label>
                                <input class="inp" name="zona" placeholder="Garita Sur" />
                            </div>

                            <div>
                                <label>Nota (opcional)</label>
                                <input class="inp" name="nota" placeholder="Observación..." />
                            </div>

                            <button class="btnx btnx-primary" type="submit">📌 Guardar</button>
                        </div>
                    </form>
                }
            </div>

            <div class="cardx">
                <h3>🧩 Acciones rápidas</h3>

                <div class="actions">
                    <form method="post" action="@Url.Action("ConsolidarContingencia","Guardia")">
                        @Html.AntiForgeryToken()
                        <button class="btnx btnx-soft" type="submit">🔁 Consolidar contingencia</button>
                    </form>

                    <a class="btnx btnx-soft" href="@Url.Action("Index","Guardia")">🔄 Recargar</a>
                </div>

                <div class="muted" style="margin-top:10px;">
                    “Consolidar” pasa los registros manuales a HistorialAccesos con Fuente = MANUAL.
                </div>
            </div>
        </div>

        <div class="cardx" style="margin-top:14px;">
            <h3>📋 Registros en contingencia pendientes</h3>

            @if (pendientes > 0)
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Evento</th>
                                <th>Placa</th>
                                <th>Zona</th>
                                <th>Nota</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (dynamic x in cont)
                            {
                                <tr>
                                    <td>@x.FechaHora</td>
                                    <td><b>@x.Evento</b></td>
                                    <td>@x.Placa</td>
                                    <td>@x.Zona</td>
                                    <td>@x.Nota</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="big">📭</div>
                    <div><b>Sin pendientes</b></div>
                    <div class="muted">Cuando el sistema esté caído y registres manualmente, aquí aparecerán.</div>
                </div>
            }
        </div>

    </div>
</div>
