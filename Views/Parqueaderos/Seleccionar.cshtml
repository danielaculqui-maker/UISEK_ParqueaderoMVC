@{
    ViewBag.Title = "Seleccionar parqueadero";
}

<h2>Seleccionar / Reservar parqueadero</h2>

<div id="geoStatus" style="margin:10px 0; padding:10px; border:1px solid #ccc; border-radius:10px;">
    Geolocalización: <strong>pendiente</strong>
</div>

<button type="button" onclick="pedirUbicacion()">📍 Usar mi ubicación (simulada)</button>

<hr />

<div style="position:relative; max-width:900px;">
    <!-- Imagen real del parqueadero -->
    <img src="@Url.Content("~/Content/Imagenes/parqueadero.jpg")"
         alt="Mapa del parqueadero (simulado)"
         style="width:100%; border-radius:12px; border:1px solid #ccc;" />

    <!-- Overlay: ejemplo de “bloques” (puedes ajustar posiciones) -->
    <button type="button" class="zona" data-zona="A" style="position:absolute; top:20%; left:15%;">Bloque A</button>
    <button type="button" class="zona" data-zona="B" style="position:absolute; top:35%; left:55%;">Bloque B</button>
    <button type="button" class="zona" data-zona="C" style="position:absolute; top:70%; left:30%;">Bloque C</button>
</div>

<p id="sugerencia" style="margin-top:12px;"></p>

@using (Html.BeginForm("GuardarSeleccion", "Parqueaderos", FormMethod.Post))
{
    <input type="hidden" id="espacioId" name="espacioId" />

    <button type="submit" style="margin-top:12px;">
        Reservar/Confirmar selección
    </button>
}

<style>
    .zona {
        background: #fff;
        border: 2px solid #1f6feb;
        padding: 8px 10px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 700;
    }

        .zona:focus {
            outline: 4px solid #ffbf00;
            outline-offset: 3px;
        }

        .zona.sugerida {
            border-color: #0a0;
            box-shadow: 0 0 0 4px rgba(0,128,0,.2);
        }
</style>

<script>
    // “Centros” de cada bloque (coordenadas simuladas cerca de tu campus)
    // Luego tú los ajustas con valores reales aproximados del campus UISEK (o inventados pero consistentes)
    const bloques = {
        A: { lat: -0.2000, lng: -78.4900 },
        B: { lat: -0.2005, lng: -78.4895 },
        C: { lat: -0.2010, lng: -78.4905 }
    };

    // Haversine (distancia en metros)
    function distM(lat1,lng1,lat2,lng2){
        const R=6371000;
        const toRad = x => x*Math.PI/180;
        const dLat = toRad(lat2-lat1);
        const dLng = toRad(lng2-lng1);
        const a = Math.sin(dLat/2)**2 +
                  Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLng/2)**2;
        return 2*R*Math.asin(Math.sqrt(a));
    }

    function pedirUbicacion(){
        const status = document.getElementById("geoStatus");
        status.innerHTML = "Geolocalización: <strong>solicitando permiso...</strong>";

        if(!navigator.geolocation){
            status.innerHTML = "Geolocalización: <strong>no soportada</strong>";
            return;
        }

        navigator.geolocation.getCurrentPosition(pos=>{
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            status.innerHTML = `Geolocalización: <strong>OK</strong> (lat ${lat.toFixed(5)}, lng ${lng.toFixed(5)})`;

            // Buscar bloque más cercano
            let mejor = null;
            let mejorD = Infinity;
            for(const k in bloques){
                const d = distM(lat,lng,bloques[k].lat,bloques[k].lng);
                if(d < mejorD){ mejorD=d; mejor=k; }
            }

            // Resaltar sugerido
            document.querySelectorAll(".zona").forEach(z => z.classList.remove("sugerida"));
            const btn = document.querySelector(`.zona[data-zona="${mejor}"]`);
            if(btn) btn.classList.add("sugerida");

            document.getElementById("sugerencia").innerHTML =
                `🤖 Sugerencia por geolocalización: <strong>Bloque ${mejor}</strong> (aprox. ${Math.round(mejorD)} m).`;
        }, err=>{
            status.innerHTML = "Geolocalización: <strong>denegada o falló</strong>. Puedes seleccionar manualmente.";
        }, { enableHighAccuracy:false, timeout:8000 });
    }

    // Selección manual (el usuario “designa” su puesto)
    document.querySelectorAll(".zona").forEach(btn=>{
        btn.addEventListener("click", ()=>{
            const zona = btn.getAttribute("data-zona");
            document.getElementById("espacioId").value = "ZONA_" + zona; // por ahora simple
            document.getElementById("sugerencia").innerHTML =
                `✅ Seleccionaste: <strong>Bloque ${zona}</strong>.`;
        });
    });
</script>
