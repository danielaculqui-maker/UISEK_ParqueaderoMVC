@{@{
        ViewBag.Title = "Seleccionar parqueadero";
        Layout = "~/Views/Shared/_Layout.cshtml"; // si tu layout ya existe
}

<style>
    .page-wrap {
        max-width: 1050px;
        margin: 20px auto;
        padding: 0 16px;
    }

    .card {
        background: #fff;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
        margin-bottom: 14px;
    }

    .muted {
        color: #555;
        font-size: 13px;
    }

    .legend {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 999px;
        border: 1px solid #ddd;
        background: #fff;
        font-weight: 700;
        font-size: 13px;
    }

    .dot {
        width: 14px;
        height: 14px;
        border-radius: 3px;
        display: inline-block;
        border: 1px solid rgba(0,0,0,.2);
    }

    /* Cine grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 10px;
        margin-top: 14px;
    }

    .slot {
        height: 44px;
        border-radius: 10px;
        border: 2px solid rgba(0,0,0,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        cursor: pointer;
        user-select: none;
    }

    .libre {
        background: #bdf5bd;
    }
    /* verde */
    .ocupado {
        background: #ffb3b3;
    }
    /* rojo */
    .discap {
        background: #b3d9ff;
    }
    /* azul */
    .cerrado {
        background: #d9d9d9;
        cursor: not-allowed;
    }
    /* gris */

    .slot:focus-visible {
        outline: 4px solid #ffbf00;
        outline-offset: 3px;
    }

    .msg {
        margin-top: 10px;
        font-weight: 700;
    }

    /* Accesibilidad con modos globales (si ya tienes clases en body) */
    body.oscuro .card {
        background: #111;
        color: #fff;
    }

    body.oscuro .muted {
        color: #ddd;
    }
</style>

<div class="page-wrap">

    <div class="card">
        <h2 style="margin:0;">🅿️ Seleccionar parqueadero</h2>
        <p class="muted" style="margin-top:6px;">
            Mapa tipo cine (simulado). Selecciona un espacio disponible.
        </p>

        <div class="legend" aria-label="Leyenda de estados">
            <span class="tag"><span class="dot" style="background:#bdf5bd"></span> Disponible</span>
            <span class="tag"><span class="dot" style="background:#ffb3b3"></span> Ocupado</span>
            <span class="tag"><span class="dot" style="background:#b3d9ff"></span> Discapacidad</span>
            <span class="tag"><span class="dot" style="background:#d9d9d9"></span> Cerrado</span>
        </div>
    </div>

    <div class="card" role="region" aria-label="Geolocalización simulada">
        <h3 style="margin:0;">📍 Geolocalización (simulada)</h3>
        <p class="muted" style="margin-top:6px;">
            Esto confirma que lo del registro visitante se guardó en sesión.
        </p>

        <ul style="margin:10px 0 0 18px;">
            <li><strong>Lat:</strong> @(ViewBag.GeoLat ?? "—")</li>
            <li><strong>Lng:</strong> @(ViewBag.GeoLng ?? "—")</li>
            <li><strong>Fuente:</strong> @(ViewBag.GeoFuente ?? "NINGUNA")</li>
        </ul>

        <p class="msg">✅ Sugerencia: <strong>@ViewBag.BloqueSugerido</strong></p>
    </div>

    <div class="card" role="region" aria-label="Mapa tipo cine">
        <h3 style="margin:0;">🎬 Mapa tipo cine (Bloque A - Zona 1)</h3>
        <p class="muted" style="margin-top:6px;">Haz click o usa TAB + ENTER para seleccionar.</p>

        <div class="grid" id="grid">
            @for (int i = 1; i <= 40; i++)
            {
                // Simulación simple de estados
                string estado = "libre";
                if (i % 7 == 0) estado = "ocupado";
                if (i % 13 == 0) estado = "cerrado";
                if (i % 11 == 0) estado = "discap";

                string label = "A" + i.ToString("00");
                <button type="button"
                        class="slot @estado"
                        data-label="@label"
                        aria-label="Espacio @label, estado @estado"
                        @(estado == "cerrado" ? "disabled" : "")
                        onclick="selectSlot('@label','@estado')">
                    @label
                </button>
            }
        </div>

        <div id="seleccion" class="msg" role="status" aria-live="polite" style="margin-top:12px;">
            Selección: —
        </div>
    </div>

</div>

<script>
    function prettyEstado(e) {
        if (e === "libre") return "Disponible";
        if (e === "ocupado") return "Ocupado";
        if (e === "discap") return "Discapacidad";
        if (e === "cerrado") return "Cerrado";
        return e;
    }

    function selectSlot(label, estado) {
        if (estado === "cerrado") {
            document.getElementById("seleccion").textContent =
                "No disponible: " + label + " está cerrado.";
            return;
        }
        if (estado === "ocupado") {
            document.getElementById("seleccion").textContent =
                "No disponible: " + label + " está ocupado.";
            return;
        }

        document.getElementById("seleccion").textContent =
            "Selección: " + label + " (" + prettyEstado(estado) + "). ✔️";
    }
</script>
